---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { NAV_LINKS, WHATSAPP_URL } from "../lib/site";

interface Props {
  /** true → header sólido desde el inicio (páginas sin hero oscuro) */
  solid?: boolean;
}
const { solid = false } = Astro.props;

// Ruta actual normalizada (sin slash final) para marcar el link activo
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, "") || "/";
  return h === path;
};
---
<header
  id="siteHeader"
  data-solid={solid ? "true" : "false"}
  class:list={["fixed inset-x-0 top-0 z-40 bg-transparent", { "is-scrolled": solid }]}
>
  <div
    class="mx-auto flex h-[80px] max-w-[1200px] items-center justify-between gap-6 px-6 md:h-[88px] max-sm:gap-3"
  >
    {/* El logo deja espacio a las 3 rayitas de HeroMenu (fixed arriba-izquierda),
         que antes quedaban tapadas:
         - <lg: ml-11 fijo (rayitas en left-3). Como ocupa más ancho, el logo baja
           por escalones en pantallas angostas (<386 / <363 / <341px) para que la
           hamburguesa no se salga del viewport.
         - lg+: rayitas en left-10 (terminan en 84px). El margen compensa solo lo
           que falta para que el logo arranque en ~104px y vale 0 desde ~1360px,
           donde el contenedor centrado ya deja el espacio. */}
    <span class="h-stagger flex items-center max-lg:ml-11 lg:ml-[max(0px,calc(80px_-_max(0px,calc((100vw_-_1200px)/2))))] max-[386px]:[&_img]:h-7 max-[363px]:[&_img]:h-6 max-[341px]:[&_img]:h-5" style="animation-delay:0s">
      <Logo dark />
    </span>

    <!-- Navegación desktop (desde lg: en tablet no cabe junto al logo y las rayitas
         de HeroMenu, el logo se aplastaba; ahí se usa el menú móvil) -->
    <nav class="hidden items-center gap-[34px] lg:flex" aria-label="Principal">
      {
        NAV_LINKS.map((l, i) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? "page" : undefined}
            class:list={[
              "h-stagger inline-block rounded-sm text-[17px] font-medium no-underline transition-[color,transform] duration-200 ease-out hover:scale-[1.06] hover:text-cyan motion-reduce:transform-none motion-reduce:hover:scale-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-navy",
              isActive(l.href) ? "text-cyan" : "text-white/90",
            ]}
            style={`animation-delay:${0.12 + i * 0.08}s`}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener"
        class="h-stagger inline-flex cursor-pointer items-center gap-[9px] rounded-full border border-white/30 bg-white/10 px-[22px] py-[12px] max-sm:px-3 text-[16px] font-semibold text-white no-underline backdrop-blur-sm transition-colors hover:border-white/60 hover:bg-white/20 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-navy"
        style={`animation-delay:${0.12 + NAV_LINKS.length * 0.08}s`}
      >
        <Icon name="whatsapp" size={18} stroke={2} />
        <span class="hidden sm:inline">WhatsApp</span>
      </a>

      <!-- Botón menú móvil -->
      <button
        id="navToggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobileNav"
        class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-white/30 text-white transition-transform active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-navy lg:hidden"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Navegación móvil desplegable -->
  <nav
    id="mobileNav"
    class="hidden border-t border-white/10 bg-navy/95 px-6 py-4 backdrop-blur-md lg:hidden"
    aria-label="Principal móvil"
  >
    <ul class="flex flex-col gap-1">
      {
        NAV_LINKS.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? "page" : undefined}
              class:list={[
                "block rounded-lg px-3 py-3 text-[15px] font-medium no-underline transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan focus-visible:ring-inset",
                isActive(l.href) ? "bg-white/10 text-cyan" : "text-white/90",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById("siteHeader");
  const toggle = document.getElementById("navToggle");
  const menu = document.getElementById("mobileNav");

  // Fondo sólido al hacer scroll (o siempre, si la página lo pide con data-solid)
  const onScroll = () => {
    if (!header) return;
    const forceSolid = header.dataset.solid === "true";
    header.classList.toggle("is-scrolled", forceSolid || window.scrollY > 40);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Menú hamburguesa
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
  // Cerrar al elegir un enlace
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    }),
  );
</script>
